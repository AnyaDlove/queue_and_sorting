tasks = [
    {'name': 'Задача 1', 'duration': 3},
    {'name': 'Задача 2', 'duration': 5},
    {'name': 'Задача 3', 'duration': 2},
]
process_tasks(tasks)


print("\nСортировка слиянием ")
unsorted = [5, 2, 9, 1, 5, 6]
print(unsorted)
print(merge_sort(unsorted))


sizes = [10, 100, 500, 1000, 2000]
merge_times = []
bubble_times = []

print("\nСравнение времени")
for size in sizes:
    data = [random.randint(0, size * 10) for _ in range(size)]
    m_time = timeit.timeit(lambda: merge_sort(data), number=50)
    b_time = timeit.timeit(lambda: bubble_sort(data), number=50)
    merge_times.append(m_time)
    bubble_times.append(b_time)
    print("Размер", size, "MergeSort", round(m_time, 5), "сек, BubbleSort", round(b_time, 5), "сек")


plt.plot(sizes, merge_times, marker='o', label='MergeSort')
plt.plot(sizes, bubble_times, marker='s', label='BubbleSort')
plt.xlabel('Размер списка')
plt.ylabel('Время (сек)')
plt.title('Сравнение времени')
plt.legend()
plt.grid(True)
plt.savefig('merge_vs_bubble.png')
plt.show()